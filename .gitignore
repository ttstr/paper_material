# --- environment ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.env
.env.*
*.pem
*.key
.DS_Store

# --- data: never commit raw / processed data (RecBoard Amazon2014Beauty_550_LOU) ---
data/processed/
data/raw/
data/recboard_build/
.freerec-venv/
*.zip
*.zip.part
*.inter
*.item
*.npy
*.safetensors
*.bin
*.gguf
**/amazon-beauty/
train.txt
valid.txt
test.txt
item_meta.txt
*.tsv
*.pkl
*.parquet

# --- model artifacts ---
results/checkpoints/
*.pt
*.pth
*.ckpt
results/online_export/
results/online_export_test/
results/eval_*.json

# --- results: ignore by default, whitelist the script-generated main-table evidence ---
results/*.json
results/*.csv
!results/.gitkeep
!results/main_table_sasrec_full.csv
!results/sasrec_full_s*_metrics.json
!results/sasrec_full_s*_metrics.csv
!results/main_table_beauty.csv
!results/*_s4[2-6]_metrics.json
!results/*_s4[2-6]_metrics.csv
!results/search_summary.csv
!results/significance_beauty.json
results/llm_cache/
results/pilot/**/raw/
# raw LLM call cache (full generations) and tensors stay local; summaries/profiles/rankings are committed
results/pilot/**/calls.jsonl
results/pilot/online_export/

# --- logs: ignore by default, keep only the small per-seed full-run training logs ---
*.log
logs/*
!logs/sasrec_full_s*.log
!logs/*_s4[2-6].log
!logs/pilot_*.log
